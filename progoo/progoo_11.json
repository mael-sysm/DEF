    "ejercicio8": {
      "id": "ejercicio8",
      "variantes_guardadas": [
        "0"
      ],
      "enunciados": {
        "0": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "Object.defineProperty(String.prototype, \"procesarRuta\", {\n\n  get() {\n    const ruta = this.valueOf();\n    // Se reemplazan los quebrados invertidos (\\) por quebrados (/)\n    const normalizada = ruta.replaceAll(\"\\\\\", \"/\");\n    // Se extrae el nombre completo (el texto después del último quebrado)\n    const posQuebrado = normalizada.lastIndexOf(\"/\");\n    const nombreCompleto = normalizada.slice(posQuebrado+1);\n    // Se ubica el último punto del nombre completo\n    const posPunto = nombreCompleto.lastIndexOf(\".\");\n    let nombre, extensión;\n    // Si el nombreCompleto tiene extensión (un punto y uno o más caracteres)\n    if (posPunto!==-1 && posPunto>0) {\n      // Se extraen el nombre y la extensión\n      nombre = nombreCompleto.slice(0, posPunto);\n      extensión = nombreCompleto.slice(posPunto+1);\n    } else {\n      // El nombre es el nombre completo y no tiene extensión\n      nombre = nombreCompleto;\n      extensión = \"Sin extensión\";\n    }\n    // Se devuelve el objeto literal\n    return {\n      rutaNormalizada: normalizada,\n      archivo: nombre,\n      extensión: extensión\n    };\n  },\n\n  configurable: true\n\n});"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "String.raw`C:\\archivos\\documentos\\reporte_anual_2026.pdf`.procesarRuta",
              "String.raw`C:\\informes\\graficas\\proyeccion_2026.jpg`.procesarRuta",
              "String.raw`C:\\documentos\\personal\\apuntes.`.procesarRuta",
              "String.raw`D:\\respaldo\\clases\\fis102_1`.procesarRuta"
            ]
          }
        ]
      }
    },
    "ejercicio9": {
      "id": "ejercicio9",
      "variantes_guardadas": [
        "0"
      ],
      "enunciados": {
        "0": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "Object.defineProperty(Array.prototype, \"generarRecibo\", {\n\n  get() {\n    // Array con los items a incluir en el recibo\n    const items = this;\n    // Fila con 32 guiones para separar el cuerpo de la tabla\n    const separador = \"-\".repeat(32);\n    // Encabezado de la tabla y fila de separación\n    let recibo = \"ARTÍCULO\".padEnd(20) + \"PRECIO\\n\" + separador + \"\\n\";\n    // Ciclo para iterar con cada uno de los items del array\n    items.forEach(item => {\n      // Fila con el nombre y el precio del item\n      recibo += item.nombre.padEnd(20, \".\") + (\"$\" + item.precio.toFixed(2)).padStart(8, \".\") + \"\\n\";\n    });\n    // Separador al final de la tabla\n    recibo += separador;\n    // Se devuelve el recibo generado\n    return recibo;\n  },\n\n  configurable: true\n\n});"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "productos = [\n  { nombre: \"Cuaderno espiral\", precio: 15.5 },\n  { nombre: \"Bolígrafo azul\", precio: 1.2 },\n  { nombre: \"Mochila escolar\", precio: 120.0 }\n];",
              "print(productos.generarRecibo);"
            ]
          }
        ]
      }
    },
    "ejercicio10": {
      "id": "ejercicio10",
      "variantes_guardadas": [
        "0"
      ],
      "enunciados": {
        "0": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "String.prototype.cifrarTexto = function(desplazamiento) {\n  // Texto desde el cual se llama al método\n  const texto = this.valueOf();\n  // Se inicializa la variable que guarda el texto cifrado\n  let resultado = \"\";\n  // Se cifran, uno a uno, los caracteres \"c\" del texto\n  for (const c of Array.from(texto)) {\n    // Si es una de las secuencias de escape elegidas no se cifra\n    if (c === \"\\n\" || c === \"\\r\" || c === \"\\t\")\n      resultado += c;\n    else\n      // Se codifica el carácter \"c\"\n      resultado += String.fromCodePoint(c.codePointAt(0) + desplazamiento);\n  }\n  // Se devuelve el texto cifrado\n  return resultado;\n};"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "texto = \"Notas:\\n\\tAlumno:\\t\\tJuan Pérez\\n\\t1er Parcial:\\t90\\n\\t2do Parcial:\\t95\";\nprint(texto);",
              "cifrado1 = texto.cifrarTexto(3);\nprint(cifrado1);",
              "cifrado2 = texto.cifrarTexto(5);\nprint(cifrado2);"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "String.prototype.descifrarTexto = function(desplazamiento) {\n  // Texto desde el cual se llama al método\n  const cifrado = this.valueOf();\n  // Se llama al método de cifrado para descifrar el texto\n  return cifrado.cifrarTexto(-desplazamiento);\n};",
              "print(cifrado1.descifrarTexto(3));",
              "print(cifrado2.descifrarTexto(5));"
            ]
          }
        ]
      }
    }
