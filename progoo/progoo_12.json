            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "s.replace(/(\\d+\\.\\d+)\\s(kg\\/h|°C)/g,\n        (match,p1,p2)=>p2===\"kg/h\"?`${(p1*35.724).toFixed(2)} oz/h`\n        :`${(p1*1+273.15).toFixed(2)} K`)"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "s.replace(/(\\d+\\.\\d+)\\s(kg\\/h|°C|atm)/g,\n        (match,p1,p2)=>p2===\"kg/h\"?`${(p1*35.724).toFixed(2)} oz/h`\n        :p2===\"°C\"?`${(p1*1+273.15).toFixed(2)} K`\n        :`${(p1*1.01325).toFixed(3)} bar`)"
            ]
          }
        ]
