          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nround(fzero(fq,[0.4, 0.6])*1e5)/1e5\nround(fzero(fq,[0.6, 0.8])*1e5)/1e5\nround(fzero(fq,[1,1.2])*1e5)/1e5\n`;",
              "`\nans =          0.43962\nans =          0.72916\nans =          1.01437\n`;"
            ]
          }
        ]
      }
    },
    "ejercicio18": {
      "id": "ejercicio18",
      "variantes_guardadas": [
        "0"
      ],
      "enunciados": {
        "0": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nformat longG;\nfunction r=f(t,v)\n x=v(1);y=v(2);\nr=[x*y+t; x-t];\nendfunction\n[vt,mr]=ode45(@f,[0,1.5],[0,1]);\nvx=mr(:,1)\nvy=mr(:,2);\nppx=spline(vt,vx);\nfx=@(t)ppval(ppx,t);\nppy=spline(vt,vy);\nfy=@(t)ppval(ppy,t);\n`;"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nglobal w;\nglobal z;\nw=fy(0.5);\nz=fx(1.5);\n`;",
              "`\nw=0.8985833611929371\nz=1.656008096844849\n`;"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nfunction r = fe(c)\n    global w;global z;\n    u=c(1); v=c(2); \n    r = [u^2.3+v^1.2-u*v-10*w;\n        3*u^2-u*v^2-v^2.9-7*z];\nendfunction\nround(fsolve(@fe,[3.1,1.9])*1e2)/1e2\n`;",
              "`\nans =\n                    2.98                    1.79\n`;"
            ]
          }
        ]
      }
    },
    "ejercicio19": {
      "id": "ejercicio19",
      "variantes_guardadas": [
        "1"
      ],
      "enunciados": {
        "1": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\npkg load optim;\nformat longG;\nvx = [2.4,4.5,6.6,8.4,9.3,10.2,11.1,12.5,14.7,16.1,17.4,18.3];\nvy = [11, 41, 90, 141, 169, 205, 251, 318, 421, 545, 592, 655];\nvi = [1.1, 1.2, 1.3];\nfa = @(c, x) c(1)*x.^2 + c(2)./x + c(3)*exp(x/8);\nc = nlinfit(vx, vy, fa, vi)\nf = @(x) fa(c, x);\n`;",
              "`\nc =\n       2.061079943682952\n       13.89870581229874\n      -2.514889855073845\n`;"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nfd=@(x,y)[y(2);y(3); 12*x.^2+10*x+36-2*y(2)-y(3)];\n[vx,mr]=ode45(fd,[5.2,9.3],[4*f(5.96),3*f(5.24),2*f(3.98)]);\nvy=mr(:,1);\npp=spline(vx,vy);\nfy=@(x)ppval(pp,x);\n`;"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nround(integral(fy,6.1,9.1)*1e2)/1e2\n`;",
              "`\nans =          2770.98\n`;"
            ]
          }
        ]
      }
    },
