            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nround(roots(r)*1e3)/1e3\n`;",
              "`\nans =\n        0.626 +       1.159i\n        0.626 -       1.159i\n       -1.391 +           0i\n       -0.718 +       1.213i\n       -0.718 -       1.213i\n`;"
