      "enunciados": {
        "2": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nformat longG;\nf=@(t,q) [q(2); 2*(20*sin(11*t)-7*q(2)-48*q(1))];\n[vx,mr]=ode45(f,[0,1.2],[0,0]);\nvy=mr(:,1);\npp=spline(vx,vy);\nfq=@(x)ppval(pp,x);\n`;"
