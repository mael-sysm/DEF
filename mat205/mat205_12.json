      ],
      "enunciados": {
        "1": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nfrom scipy.integrate import solve_ivp\nimport numpy as np\nf=lambda x,y: x**3+1.1*y**2\ns=solve_ivp(f,[0,0.45],[2],dense_output=True,rtol=1e-5)\nfy=lambda x:s.sol(x)[0]\n`;"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "`\nr=fy([0,0.2,0.3,0.35,0.4,0.45]).round(2)\nprint(r)\n`;",
              "`\n[ 2.     3.57   5.89   8.71  16.71 207.3]\n`;"
            ]
          },
          {
            "tipo": "codigo",
