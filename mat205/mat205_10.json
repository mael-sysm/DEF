            "tipo": "codigo",
            "instrucciones": [
              "`function res=fr(v):\n global f;x=v(1);y=v(2);\n res=[res=[x^2+2*x*y^2-f(5)-44,\n      x^2*y-3*x^2*y^2+f(6)+117];]\nendfunction\nround(fsolve(@fr,[1,2])*1e3)/1e3\n`;",
              "`ans =\n        2.107        3.193\n`;"
