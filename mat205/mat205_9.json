      ],
      "enunciados": {
        "1": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "var td=[[2,1.4,4,3.6,7.4,6.2,1.2,3,5.5,7.3,2.8,3.2],\n        [2.3,4.3,3.2,2.5,5.1,3.3,6.1,4.2,2.2,1.3,2.6,2.9],\n        [1.71,1.36,4.51,3.44,10.40,6.93,1.03,3.72,4.68,3.94,2.80,3.26]];\nvar vi=[1.1,1.2,1.3,1.4,1.5];\nvar fa=([a,b,c,d,e],[x,y])=>(a+b*Math.log(x)+c*Math.log(y))/(d/x+e/y);\nvar {f,c,r}=fa.mincuadSimplex({td,vi});\nprint(c);r",
              "var td2=[[1,2.2,3.3,4.4,5.6,7.7,8.8],\n         [1.5,2.3,3.5,4.8,5.9,7.9,9]];\ntd2.transpose().map(([x,y])=>f(x,y).round(2))"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "var trace1 = {\n  x:td[0] , \n  y:td[1] ,\n  z: td[2],\n  mode: \"markers\",\n  marker: {\n    size: 7,\n    color: \"fuchsia\",\n  },\n  type: \"scatter3d\"\n};",
              "var[x,y ,[z] ] = getAxes({fun:[f], xmin:0.2, xmax:8.4, dx:0.2, ymin:0.3, ymax:7.1, dy:0.2}).round(2);",
              "var trace2 = {\n  x,\n  y,\n  z,\n  contours: {\n    x:{show:true, color: \"gray\"},\n    y:{show:true, color: \"gray\"},\n    z:{show:true, color: \"gray\"},\n  },\n  colorscale: \"Greens\",\n  showscale: false,\n  type: \"surface\"\n};",
              "var layout = {\n  scene: {\n    aspectratio: {x:1, y:1, z:1},\n  }\n};",
              "plotly([trace1,trace2],layout )"
            ]
          }
        ],
        "2": [
          {
            "tipo": "codigo",
            "instrucciones": [
