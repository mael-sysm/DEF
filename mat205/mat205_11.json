      "enunciados": {
        "2": [
          {
            "tipo": "codigo",
            "instrucciones": [
              "var fw = w => Math.sqrt((3*w**2.1+5*w-3)/(w**1.7+3*w+1));\nvar d1 = fw.df1(1.2).round(2);\nvar d2 = fw.df2(1.2).round(2);\nvar d3 = fw.df3(1.2).round(2);"
            ]
          },
          {
            "tipo": "codigo",
            "instrucciones": [
              "var fe = ([x,y,z]) => [\n  1.15*Math.log(x)+(5*y)**2+z-d1,\n  x**1.2-0.074*Math.exp(y)-Math.cos(z)-d2,\n  4*x**2+3.25*y**2+5*z**2-d3\n];\nfe.newtonnl({vi:[0.6,0.4,0.2],err:8 }).v.round(2)"
            ]
          }
        ]
      }
    },
