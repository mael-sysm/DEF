          {
            "tipo": "codigo",
            "instrucciones": [
              "var fy = y => (Math.sin(y)+2*Math.cos(y))/(2*y+4);\nvar d1 = fy.df1(0.3).round(2);\nvar d2 = fy.df2(0.3).round(2);\nvar d3 = fy.df3(0.3).round(2);\nvar d4 = fy.df4(0.3).round(2);"
